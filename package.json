{
  "name": "@diffson/monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": {
    "packages": ["packages/*", "apps/*"],
    "catalog": {
      "@types/bun": "latest",
      "typescript": "^5.7.0"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "cli": "bun --conditions=@diffson/source apps/cli/src/index.tsx"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "turbo": "^2",
    "typescript": "catalog:"
  }
}