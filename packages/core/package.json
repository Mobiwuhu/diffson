{
  "name": "@diffson/core",
  "version": "1.0.4",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.map",
    "README.md"
  ],
  "imports": {
    "#contract": {
      "@diffson/source": "./src/contract/index.ts",
      "default": "./dist/contract/index.js"
    },
    "#service": {
      "@diffson/source": "./src/service/index.ts",
      "default": "./dist/service/index.js"
    }
  },
  "exports": {
    ".": {
      "import": {
        "@diffson/source": "./src/index.ts",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "@diffson/source": "./src/index.ts",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
    "test": "bun --conditions=@diffson/source test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@wendellhu/redi": "catalog:",
    "is-json": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}