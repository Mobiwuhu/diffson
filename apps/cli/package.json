{
  "name": "@diffson/cli",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "diffson": "./dist/src/index.js",
    "diffson-interactive": "./dist/src/interactive.js"
  },
  "imports": {
    "#*": [
      "./src/*/index.ts",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*"
    ]
  },
  "exports": {
    ".": {
      "import": {
        "@diffson/source": "./src/index.tsx",
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "dev": "bun --conditions=@diffson/source src/index.tsx --help",
    "interactive": "bun dist/src/interactive.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@diffson/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}