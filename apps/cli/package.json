{
  "name": "@diffson/cli",
  "version": "1.0.7",
  "type": "module",
  "bin": {
    "diffson": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "imports": {
    "#*": [
      "./src/*/index.ts",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*"
    ]
  },
  "scripts": {
    "build": "rm -rf dist && mkdir -p dist && bun run build.ts",
    "dev": "bun --conditions=@diffson/source src/index.tsx",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@diffson/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": ">=1.0.0",
      "onFail": "warn"
    }
  }
}
