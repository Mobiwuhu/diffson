{
  "compilerOptions": {
    "outDir": "${configDir}/dist",
    "baseUrl": "${configDir}",
    "composite": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "customConditions": [
      "@diffson/source"
    ],
    "lib": [
      "ESNext",
      "DOM"
    ],
    "paths": {
      "#*": [
        "./src/*"
      ]
    },
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "exclude": [
    "${configDir}/dist",
    "${configDir}/node_modules",
    "${configDir}/src/**/*.test.ts"
  ]
}